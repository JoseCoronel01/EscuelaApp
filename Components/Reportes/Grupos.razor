@page "/reportes/grupos"
@inject ReporteService ReporteSvc
@inject InscripcionService InscSvc
@inject IJSRuntime JS

<PageTitle>Reporte por Grupo — EduSys</PageTitle>

<div class="page-container">
    <div class="toolbar">
        <div class="toolbar-left">
            <p class="toolbar-hint">Rendimiento académico agrupado por grupo escolar.</p>
        </div>
        <div class="toolbar-right">
            <button class="btn btn-excel" @onclick="ExportarInscripcionesAsync">📥 Exportar Inscripciones</button>
        </div>
    </div>

    @if (_cargando)
    {
        <div class="loading-state"><div class="spinner"></div></div>
    }
    else
    {
        <div class="kpi-grid kpi-grid-3">
            <div class="kpi-card kpi-blue">
                <div class="kpi-icon">🏫</div>
                <div class="kpi-body">
                    <span class="kpi-value">@_grupos.Count</span>
                    <span class="kpi-label">Grupos Evaluados</span>
                </div>
            </div>
            <div class="kpi-card kpi-green">
                <div class="kpi-icon">✅</div>
                <div class="kpi-body">
                    <span class="kpi-value">@_grupos.Sum(g => g.Aprobados)</span>
                    <span class="kpi-label">Total Aprobados</span>
                </div>
            </div>
            <div class="kpi-card kpi-orange">
                <div class="kpi-icon">⚠️</div>
                <div class="kpi-body">
                    <span class="kpi-value">@_grupos.Sum(g => g.Reprobados)</span>
                    <span class="kpi-label">Total Reprobados</span>
                </div>
            </div>
        </div>

        <div class="table-card">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Grupo</th>
                        <th>Grado</th>
                        <th class="text-center">Alumnos Evaluados</th>
                        <th class="text-center">Promedio del Grupo</th>
                        <th class="text-center">Aprobados</th>
                        <th class="text-center">Reprobados</th>
                        <th>Desempeño</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var g in _grupos)
                    {
                        var total = g.Aprobados + g.Reprobados;
                        var pct = total > 0 ? (int)((g.Aprobados / (double)total) * 100) : 0;
                        <tr>
                            <td><strong>@g.Grupo</strong></td>
                            <td>@g.Grado</td>
                            <td class="text-center">@g.TotalAlumnos</td>
                            <td class="text-center">
                                <span class="badge @(g.Promedio >= 6 ? "badge-success" : "badge-danger")">
                                    @g.Promedio
                                </span>
                            </td>
                            <td class="text-center">@g.Aprobados</td>
                            <td class="text-center">@g.Reprobados</td>
                            <td>
                                <div class="progress-bar-wrap mini">
                                    <div class="progress-bar" style="width: @pct%"></div>
                                </div>
                                <span class="progress-label-sm">@pct% aprobación</span>
                            </td>
                        </tr>
                    }
                    @if (_grupos.Count == 0)
                    {
                        <tr><td colspan="7" class="empty-row">No hay datos de calificaciones registrados</td></tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private List<PromedioGrupo> _grupos = new();
    private bool _cargando = true;

    protected override async Task OnInitializedAsync()
    {
        _grupos = await ReporteSvc.ObtenerPromediosPorGrupoAsync();
        _cargando = false;
    }

    private async Task ExportarInscripcionesAsync()
    {
        var bytes = await InscSvc.ExportarExcelAsync();
        await JS.InvokeVoidAsync("downloadFile", Convert.ToBase64String(bytes),
            $"Inscripciones_Reporte_{DateTime.Now:yyyyMMdd}.xlsx",
            "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");
    }
}
